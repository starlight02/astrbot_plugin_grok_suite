{
    "grok_api_url": {
        "description": "Grok API 地址",
        "hint": "只需填写基础 URL，如: https://api.x.ai，会自动拼接接口路径",
        "type": "string",
        "default": "https://api.x.ai"
    },
    "grok_api_key": {
        "description": "Grok API 密钥",
        "hint": "请填写你的 API 密钥",
        "type": "string",
        "default": ""
    },
    "grok_search_model": {
        "description": "对话/搜索模型",
        "hint": "默认 grok-4-fast",
        "type": "string",
        "default": "grok-4-fast"
    },
    "grok_image_backend_type": {
        "description": "生图后端类型",
        "hint": "xAI 使用官方 JSON 请求；grok2api 使用 chenyme/grok2api 兼容请求",
        "type": "string",
        "options": [
            "xAI",
            "grok2api"
        ],
        "default": "xAI"
    },
    "grok_image_api_url": {
        "description": "生图 API 地址",
        "hint": "可选；为空继承全局 Grok API 地址。填写基础 URL，如 https://api.x.ai 或第三方代理地址",
        "type": "string",
        "default": ""
    },
    "grok_image_api_key": {
        "description": "生图 API 密钥",
        "hint": "可选；为空继承全局 Grok API 密钥",
        "type": "string",
        "default": ""
    },
    "grok_image_model": {
        "description": "文生图模型",
        "hint": "图像生成模型，默认 grok-imagine-image-quality",
        "type": "string",
        "default": "grok-imagine-image-quality"
    },
    "grok_edit_model": {
        "description": "图生图模型",
        "hint": "图像编辑模型，默认 grok-imagine-image-quality",
        "type": "string",
        "default": "grok-imagine-image-quality"
    },
    "grok_image_resolution": {
        "description": "图片分辨率",
        "hint": "xAI Imagine 图片生成/编辑分辨率，默认 2k",
        "type": "string",
        "options": [
            "1k",
            "2k"
        ],
        "default": "2k"
    },
    "grok_video_backend_type": {
        "description": "视频后端类型",
        "hint": "xAI 使用官方视频生成/编辑/扩展接口；grok2api 使用 /v1/videos 兼容接口，仅支持生视频",
        "type": "string",
        "options": [
            "xAI",
            "grok2api"
        ],
        "default": "xAI"
    },
    "grok2api_video_preset": {
        "description": "grok2api 视频模式",
        "hint": "仅 grok2api 视频后端生效；会作为 /v1/videos 的 preset 发送，默认 custom",
        "type": "string",
        "options": [
            "custom",
            "fun",
            "normal",
            "spicy"
        ],
        "default": "custom"
    },
    "grok_video_api_url": {
        "description": "视频 API 地址",
        "hint": "可选；为空继承全局 Grok API 地址。填写基础 URL，如 https://api.x.ai 或第三方代理地址",
        "type": "string",
        "default": ""
    },
    "grok_video_api_key": {
        "description": "视频 API 密钥",
        "hint": "可选；为空继承全局 Grok API 密钥",
        "type": "string",
        "default": ""
    },
    "grok_video_model": {
        "description": "视频模型",
        "hint": "视频生成模型，默认 grok-imagine-video",
        "type": "string",
        "default": "grok-imagine-video"
    },
    "grok_video_edit_model": {
        "description": "视频编辑模型",
        "hint": "视频编辑模型，默认 grok-imagine-video",
        "type": "string",
        "default": "grok-imagine-video"
    },
    "grok_video_extension_model": {
        "description": "视频扩展模型",
        "hint": "视频扩展模型，默认 grok-imagine-video",
        "type": "string",
        "default": "grok-imagine-video"
    },
    "grok_video_resolution": {
        "description": "视频分辨率",
        "hint": "xAI 支持 480p/720p/1080p；grok2api 支持 480p/720p，不支持时自动回退 720p",
        "type": "string",
        "options": [
            "480p",
            "720p",
            "1080p"
        ],
        "default": "720p"
    },
    "grok_video_aspect_ratio": {
        "description": "视频默认比例",
        "hint": "文生视频/参考图视频默认 aspect_ratio；选 null 表示发送 JSON null；单图图生视频未显式输入比例时不传，保持原图比例",
        "type": "string",
        "options": [
            "null",
            "1:1",
            "16:9",
            "9:16",
            "4:3",
            "3:4",
            "3:2",
            "2:3"
        ],
        "default": "16:9"
    },
    "grok_video_duration": {
        "description": "视频默认时长",
        "hint": "xAI 视频生成 duration，文生/单图支持 1-15 秒，参考图视频支持 1-10 秒，默认 8 秒",
        "type": "int",
        "default": 8
    },
    "grok_video_output_upload_url": {
        "description": "视频输出上传 URL",
        "hint": "可选；填写后作为官方 output.upload_url 随视频生成/编辑/扩展请求发送",
        "type": "string",
        "default": ""
    },
    "grok_video_extension_duration": {
        "description": "视频扩展时长",
        "hint": "视频扩展片段时长，支持 1-10 秒，默认 6 秒",
        "type": "int",
        "default": 6
    },
    "grok_search_mode": {
        "description": "搜索模式",
        "hint": "auto=模型自动判断是否联网, on=始终联网, off=纯对话不联网",
        "type": "string",
        "default": "auto"
    },
    "grok_search_enable_thinking": {
        "description": "对话思考模式",
        "hint": "开启后会附带 reasoning 参数",
        "type": "bool",
        "default": true
    },
    "grok_search_thinking_budget": {
        "description": "对话思考预算",
        "hint": "仅在开启思考模式时生效",
        "type": "int",
        "default": 32000
    },
    "grok_search_timeout_seconds": {
        "description": "对话超时时间（秒）",
        "hint": "默认 60 秒",
        "type": "int",
        "default": 60
    },
    "grok_search_show_sources": {
        "description": "显示来源链接",
        "hint": "开启后在结果中附加来源链接",
        "type": "bool",
        "default": false
    },
    "grok_search_max_sources": {
        "description": "最多显示来源数量",
        "hint": "0 表示不限制",
        "type": "int",
        "default": 5
    },
    "grok_search_extra_body": {
        "description": "对话额外请求体（JSON）",
        "hint": "例如: {\"max_tokens\":4096}",
        "type": "text",
        "default": "{}"
    },
    "grok_search_extra_headers": {
        "description": "对话额外请求头（JSON）",
        "hint": "例如: {\"X-Trace-Id\":\"your-id\"}",
        "type": "text",
        "default": "{}"
    },
    "grok_search_enable_skill": {
        "description": "启用 Skill 模式（禁用 LLM Tool）",
        "hint": "当你已安装 grok-search skill 脚本时开启",
        "type": "bool",
        "default": false
    },
    "save_media": {
        "description": "保存媒体文件",
        "hint": "开启后图片和视频将保存到本地",
        "type": "bool",
        "default": false
    },
    "user_whitelist": {
        "description": "用户白名单",
        "hint": "允许使用此插件的用户ID列表，为空则不限制",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": []
    },
    "user_blacklist": {
        "description": "用户黑名单",
        "hint": "禁止使用此插件的用户ID列表",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": []
    },
    "group_whitelist": {
        "description": "群聊白名单",
        "hint": "允许使用此插件的群聊ID列表，为空则不限制",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": []
    },
    "group_blacklist": {
        "description": "群聊黑名单",
        "hint": "禁止使用此插件的群聊ID列表",
        "type": "list",
        "items": {
            "type": "string"
        },
        "default": []
    }
}
